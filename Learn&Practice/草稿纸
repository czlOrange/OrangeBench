// 连接专用缓冲区管理器 - 为单个TCP连接管理发送和接收数据的缓冲区
class ConnectionBufferManager {
public:
    // 构造函数：依赖注入全局缓冲区管理器
    explicit ConnectionBufferManager(std::shared_ptr<IBufferManager> manager);
    // 析构函数：清理资源
    ~ConnectionBufferManager();
    
    // 发送缓冲区管理
    bool EnqueueSend(const BufferView& data);                    // 将待发送数据加入发送队列（排队等待发送）
    BufferView PeekSend() const noexcept;                         // 查看队首待发送的数据（不移除）
    void ConsumeSend(size_t bytes);                               // 确认已发送bytes字节，从队首移除
    size_t GetSendQueueSize() const noexcept;                     // 获取发送队列中待发送的总字节数
    bool IsSendQueueEmpty() const noexcept;                       // 判断发送队列是否为空
    
    // 接收缓冲区管理
    bool PrepareReceive(size_t expected_size);                    // 准备接收缓冲区，确保有足够空间
    BufferView GetReceiveBuffer() noexcept;                        // 获取可写的接收缓冲区（用于recv系统调用）
    void CommitReceive(size_t bytes);                              // 提交接收到的bytes字节数据（标记已写入）
    size_t GetReceiveBufferSize() const noexcept;                  // 获取接收缓冲区中已接收的数据大小
    
    // 缓冲区状态
    void ClearAll() noexcept;                                      // 清空所有发送队列和接收缓冲区
    void Swap(ConnectionBufferManager& other) noexcept;            // 高效交换两个连接管理器状态
    
    // 配置
    void SetMaxSendQueueSize(size_t size);                         // 设置发送队列最大长度（防止内存无限增长）
    void SetReceiveBufferStrategy(std::function<size_t(size_t)> strategy); // 设置接收缓冲区扩容策略（如线性增长、倍增等）
    
private:
    std::shared_ptr<IBufferManager> buffer_manager_;               // 依赖的全局内存池管理器
    std::vector<std::unique_ptr<Buffer>> send_queue_;              // 发送队列：存放待发送的数据块
    std::unique_ptr<Buffer> receive_buffer_;                       // 接收缓冲区：存放收到的数据
    size_t send_consumed_{0};                                       // 发送队列中已消耗的字节数（用于部分发送）
    size_t receive_committed_{0};                                   // 接收缓冲区中已提交的字节数
    size_t max_send_queue_size_{1024 * 1024};                      // 发送队列最大字节数限制（默认1MB）
    std::function<size_t(size_t)> receive_strategy_;                // 接收缓冲区扩容策略函数
};